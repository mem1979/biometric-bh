<?xml version = "1.0" encoding = "UTF-8"?>

<!DOCTYPE aplicacion SYSTEM "dtds/aplicacion.dtd">

<aplicacion nombre="biometric">

	<!--
	Un módulo por defecto se asume para cada
	controlador en <modulo-defecto/> 
	-->
	<modulo-defecto>
		<controlador nombre="Typical"/>
	</modulo-defecto>

	<modulo nombre="DashboardAsistencia">
		<modelo nombre="DashboardAsistencia"/>
		<controlador nombre="InitModelWithNewInstance"/>
	</modulo>

	<modulo nombre="Licencia">
		<var-entorno nombre="XAVA_SEARCH_ACTION" valor="CRUD.searchReadOnly"/>
		<!-- 1 -->
		<modelo nombre="Licencia"/>
		<controlador nombre="Print"/>
		<!-- 2 -->
	</modulo>
<!--
	<modulo nombre="Personal">
		<var-entorno nombre="XAVA_SEARCH_ACTION" valor="Personal.search"/>
		<modelo nombre="Personal"/>
		<controlador nombre="Personal"/>
		<controlador-modo nombre="PersonalMode"/>
	</modulo>
-->


	<!--
	

	
	Podemos definir módulos adicionales, por ejemplo: 	
	<modulo nombre="ProfesorSoloLectura">
		<modelo nombre="Profesor"/>
		<controlador nombre="Print"/>
	</modulo>		
	-->

	<!-- ============================================================ -->
	<!-- MÓDULO DE PAPELERA DE PERSONAL                               -->
	<!-- ============================================================ -->
	<!-- 
	Este módulo muestra los legajos que fueron eliminados lógicamente 
	y permite restaurarlos o eliminarlos permanentemente del sistema.
	-->
	<modulo nombre="PapeleraPersonal">
		<!-- Variable de entorno para mostrar acción restaurar en cada fila -->
		<var-entorno nombre="XAVA_LIST_ACTION" valor="PapeleraPersonal.restaurar"/>
		<modelo nombre="Personal"/>
		<!-- Usa @Tab con name="Eliminado" definido en Personal.java -->
		<tab nombre="Eliminado"/>
		<controlador nombre="PapeleraPersonal"/>
	</modulo>

</aplicacion>

