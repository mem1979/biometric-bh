			<textField>
				<reportElement x="140" y="168" width="400" height="20" forecolor="#757575" uuid="b2b2b2b2-b2b2-4b2b-8b2b-b2b2b2b2b2b2"/>
				<textElement>
					<font size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["Ingreso: " + $P{fechaIngreso} + " | Antigüedad: " + $P{antiguedad}]]></textFieldExpression>
