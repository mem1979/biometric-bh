	<group name="Seccion3_Horas">
		<groupExpression><![CDATA[1]]></groupExpression>
		<groupHeader>
			<band height="320">
				<staticText>
					<reportElement x="0" y="0" width="555" height="30" forecolor="#1A237E" uuid="a7a7a7a7-a7a7-4a7a-8a7a-a7a7a7a7a7a7"/>
					<box>
						<bottomPen lineWidth="2.0" lineColor="#1A237E"/>
					</box>
					<textElement>
						<font size="16" isBold="true"/>
					</textElement>
					<text><![CDATA[3. HORAS TRABAJADAS]]></text>
				</staticText>
				<staticText>
					<reportElement x="10" y="40" width="200" height="20" forecolor="#424242" uuid="b7b7b7b7-b7b7-4b7b-8b7b-b7b7b7b7b7b7"/>
					<textElement>
						<font size="10" isBold="true"/>
					</textElement>
					<text><![CDATA[Promedio Mensual:]]></text>
				</staticText>
				<textField>
					<reportElement x="210" y="40" width="100" height="20" forecolor="#1976D2" uuid="c7c7c7c7-c7c7-4c7c-8c7c-c7c7c7c7c7c7"/>
					<textElement>
						<font size="11" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{promedioHorasMensual} + " horas"]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement x="10" y="65" width="200" height="20" forecolor="#424242" uuid="d7d7d7d7-d7d7-4d7d-8d7d-d7d7d7d7d7d7"/>
					<textElement>
						<font size="10" isBold="true"/>
					</textElement>
					<text><![CDATA[Mes con Mayor Carga:]]></text>
				</staticText>
				<textField>
					<reportElement x="210" y="65" width="200" height="20" forecolor="#388E3C" uuid="e7e7e7e7-e7e7-4e7e-8e7e-e7e7e7e7e7e7"/>
					<textElement>
						<font size="11" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA[$P{mesMayorCarga} + " (" + $P{horasMayorCarga} + " hrs)"]]></textFieldExpression>
				</textField>
				<barChart>
					<chart evaluationTime="Report" theme="default">
						<reportElement x="0" y="95" width="555" height="200" uuid="c1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e5f"/>
						<chartTitle>
							<font size="12" isBold="true"/>
							<titleExpression><![CDATA["Horas Trabajadas por Mes"]]></titleExpression>
						</chartTitle>
						<chartSubtitle/>
						<chartLegend position="Bottom"/>
					</chart>
					<categoryDataset>
						<dataset>
							<datasetRun subDataset="dsHoras" uuid="d2e3f4a5-b6c7-4d8e-9f0a-1b2c3d4e5f6a">
								<dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($P{listaMensual})]]></dataSourceExpression>
							</datasetRun>
						</dataset>
						<categorySeries>
							<seriesExpression><![CDATA["Horas Normales"]]></seriesExpression>
							<categoryExpression><![CDATA[$F{mes}]]></categoryExpression>
							<valueExpression><![CDATA[$F{horasNormales}]]></valueExpression>
						</categorySeries>
						<categorySeries>
							<seriesExpression><![CDATA["Horas Extras"]]></seriesExpression>
							<categoryExpression><![CDATA[$F{mes}]]></categoryExpression>
							<valueExpression><![CDATA[$F{horasExtras}]]></valueExpression>
						</categorySeries>
						<categorySeries>
							<seriesExpression><![CDATA["Horas Especiales"]]></seriesExpression>
							<categoryExpression><![CDATA[$F{mes}]]></categoryExpression>
							<valueExpression><![CDATA[$F{horasEspeciales}]]></valueExpression>
						</categorySeries>
					</categoryDataset>
